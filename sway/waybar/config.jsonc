// -*- mode: jsonc -*-
{
  "reload_style_on_change": true,
  "spacing": 16,
  // Choose the order of the modules
  "modules-left": [
    "custom/arch_menu",
    "backlight",
    "pulseaudio",
    "custom/updates"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/tailscale",
    "network",
    "bluetooth",
    "battery"
  ],

  "custom/arch_menu": {
    "format": "󰣇",
    "on-click": "rofi -show drun",
    "tooltip": false
  },
  "backlight": {
    "format": "{icon}\u2002{percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "min-brightness": 1,
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [""]
    },
    "on-click": "pactl set-sink-mute \\@DEFAULT_SINK@ toggle"
  },
  "custom/updates": {
    "exec": "/home/toni/.config/waybar/scripts/updates.sh",
    "interval": 10,
    "on-click": "kitty -e yay -Su",
    "format": "{}",
    "tooltip": false
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d-%m-%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/tailscale": {
    "exec": "/home/toni/.config/waybar/scripts/tailscale.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "/home/toni/.config/waybar/scripts/tailscale_toggle.sh",
    "format": "{}"
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-disconnected": "󰖪",
    "on-click": "kitty -e nmtui",
    "on-click-right": "ip route get 1.1.1.1 | awk '{print $7}' | tr -d '\\n' | wl-copy",
    "tooltip-format": "IP: {ipaddr}"
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂯\u2004{device_alias}",
    "format-connected-battery": "󰂯\u2004{device_alias} 󰥉\u2006{device_battery_percentage}%",
    "on-click": "kitty -e bluetui",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
    },
    "format": "{icon}\u2004{capacity}%",
    "format-charging": "󰂄\u2004{capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
